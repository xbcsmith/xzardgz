{
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "security-review",
          "version": "1.0.0",
          "rules": [
            {
              "id": "secrets",
              "shortDescription": {
                "text": "secrets - CRITICAL security issue"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "secrets",
          "message": {
            "text": "data exposure [CWE-798] [A07:2021]\n\nRemediation: use env vars"
          },
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/main.rs"
                },
                "region": {
                  "startLine": 10
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
